# Ambiente de produção. Copie para `.env.production` e preencha.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# Os três domínios precisam apontar para o IP da VM ANTES do primeiro `up`: o
# Caddy tenta emitir os certificados no boot e o Let's Encrypt tem limite de
# tentativas por domínio.

# --- Domínios ---
# O app do cidadão fica na raiz (o manifesto do PWA declara start_url '/').
CITIZEN_DOMAIN="zeladoria.exemplo.gov.br"
ADMIN_DOMAIN="painel.zeladoria.exemplo.gov.br"
STORAGE_DOMAIN="fotos.zeladoria.exemplo.gov.br"
# Subdomínios do MESMO domínio registrável, e isso não é estética: o cookie de
# sessão é `sameSite: lax`. Espalhar os apps por domínios diferentes faz o
# navegador engolir o cookie no /auth/refresh, e a sessão cai a cada 15 min.

# Para onde o Let's Encrypt avisa sobre renovação vencendo.
ACME_EMAIL="ti@exemplo.gov.br"

# --- Banco ---
POSTGRES_USER="zeladoria"
POSTGRES_DB="zeladoria"
# Gere: openssl rand -base64 32
POSTGRES_PASSWORD=""

# --- Tokens ---
# Gere cada um: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Precisam ser DIFERENTES entre si e ter no mínimo 32 caracteres — a API recusa
# subir se forem menores.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# --- Storage ---
S3_BUCKET="zeladoria"
S3_REGION="us-east-1"
# Estas são as credenciais de ROOT do MinIO, não as de desenvolvimento.
# Gere: openssl rand -base64 24
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Vida da URL assinada da foto. Curta de propósito: uma vez emitida, ela vale
# para quem a tiver, independente de papel.
PHOTO_URL_TTL_SECONDS="300"

# --- Mapa do painel ---
# Centro e zoom iniciais. O padrão é Rio Branco (AC).
VITE_MAP_LAT="-9.97499"
VITE_MAP_LNG="-67.8243"
VITE_MAP_ZOOM="13"
